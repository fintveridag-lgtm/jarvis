PORT=3000

# ElevenLabs (voice brief)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional override, defaults to eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# Meta / Facebook Graph API — shared token used for Ads, Instagram and client accounts
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Client performance box (box 3) — separate Meta ad accounts, month-to-date
CLIENT_A_NAME=Klient A
CLIENT_A_AD_ACCOUNT_ID=
CLIENT_B_NAME=Klient B
CLIENT_B_AD_ACCOUNT_ID=

# Notion — only used by the morning routine (scripts/morning-routine-prompt.md),
# not read directly by the server
NOTION_API_KEY=
NOTION_HOME_PAGE_ID=

# Dagsavisen — natt-pipeline (scripts/avis-pipeline/). Ingen nøkler kreves.
# Ollama kjører lokalt; overstyr modell/adresse ved behov.
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434
# Valgfritt: ntfy-varsel når avisen er ferdig. Velg et hemmelig emne-navn og
# abonner på det i ntfy-appen på telefonen (https://ntfy.sh).
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# Valgfritt: Claude-finpuss om morgenen (scripts/avis-pipeline/polish.mjs).
# Uten nøkkel hoppes trinnet over, og avisen beholder Ollama-tekstene.
# Nøkkel fra console.anthropic.com. Koster litt per kjøring.
ANTHROPIC_API_KEY=
# Overstyr modell ved behov (f.eks. claude-haiku-4-5 for lavere kostnad).
CLAUDE_MODEL=claude-opus-5
